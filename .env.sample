OTEL_SERVICE_NAME=python-flask.docker
OTEL_RESOURCE_ATTRIBUTES=service.instance.id=docker,deployment.environment.name=dev,service.namespace=localhost,service.version=0.1.0
OTEL_EXPORTER_OTLP_LOGS_HEADERS=Content-Type=application/x-protobuf,Authorization=Bearer abc:123,x-observe-target-package=Host Explorer
OTEL_EXPORTER_OTLP_TRACES_HEADERS=Content-Type=application/x-protobuf,Authorization=Bearer abc:123,x-observe-target-package=Tracing
OTEL_EXPORTER_OTLP_METRICS_HEADERS=Content-Type=application/x-protobuf,Authorization=Bearer abc:123,x-observe-target-package=Metrics
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://123456789012.collect.observeinc.com/v2/otel/v1/logs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://123456789012.collect.observeinc.com/v2/otel/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://123456789012.collect.observeinc.com/v2/otel/v1/traces
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
MONGODB_URI=mongodb+srv://user:pass@cluster0.abcdefg.mongodb.net/?appName=Cluster0
LAMBDA_ENDPOINT=https://abcdefghijklmnopqrstuvwxyz.lambda-url.ca-central-1.on.aws
